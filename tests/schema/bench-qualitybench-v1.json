{
 "$id": "https://launch80.com/schemas/bench.qualitybench.v1.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "$template",
  "schema_version",
  "title",
  "model",
  "env",
  "tasks",
  "logprobs"
 ],
 "properties": {
  "$template": {
   "type": "string",
   "const": "bench.qualitybench.v1"
  },
  "schema_version": {
   "type": "integer",
   "enum": [
    1
   ]
  },
  "qualitybench_version": {
   "type": "string",
   "maxLength": 32
  },
  "title": {
   "type": "string",
   "minLength": 1,
   "maxLength": 160
  },
  "summary": {
   "type": "string",
   "minLength": 1,
   "maxLength": 600
  },
  "model": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "generated": {
   "type": "string",
   "maxLength": 40
  },
  "env": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "date": {
     "type": "string",
     "maxLength": 40
    },
    "model": {
     "type": "string",
     "maxLength": 200
    },
    "precision": {
     "type": "string",
     "maxLength": 40
    },
    "engine": {
     "type": "string",
     "maxLength": 80
    },
    "gpu": {
     "type": "string",
     "maxLength": 120
    },
    "lm_eval": {
     "type": "string",
     "maxLength": 40
    },
    "evalplus": {
     "type": "string",
     "maxLength": 40
    },
    "bfcl_eval": {
     "type": "string",
     "maxLength": 40
    },
    "evalplus_image": {
     "type": "string",
     "maxLength": 200
    },
    "sandbox": {
     "type": "string",
     "maxLength": 80
    },
    "thinking_on_min_max_tokens": {
     "type": "integer",
     "minimum": 0,
     "maximum": 10000000
    }
   }
  },
  "stats": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "resamples": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10000000
    },
    "seed": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4294967295
    }
   }
  },
  "tasks": {
   "type": "array",
   "minItems": 1,
   "maxItems": 32,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "off"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,32}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "how": {
      "type": "string",
      "maxLength": 200
     },
     "off": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "k",
       "n",
       "acc",
       "ci"
      ],
      "properties": {
       "k": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
       },
       "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
       },
       "acc": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "ci": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        }
       },
       "src": {
        "type": "string",
        "maxLength": 80
       }
      }
     },
     "on": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "k",
       "n",
       "acc",
       "ci"
      ],
      "properties": {
       "k": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
       },
       "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
       },
       "acc": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "ci": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number",
         "minimum": 0,
         "maximum": 100
        }
       },
       "src": {
        "type": "string",
        "maxLength": 80
       }
      }
     },
     "paired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "n",
       "delta",
       "ci",
       "ref_only",
       "test_only",
       "p"
      ],
      "properties": {
       "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
       },
       "delta": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
       },
       "ci": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number",
         "minimum": -100,
         "maximum": 100
        }
       },
       "ref_only": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
       },
       "test_only": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
       },
       "p": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      }
     }
    }
   }
  },
  "logprobs": {
   "type": "object",
   "maxProperties": 3,
   "propertyNames": {
    "pattern": "^[A-Za-z0-9_.-]{1,32}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "label",
     "windows",
     "positions",
     "ppl",
     "win_ppl",
     "nll_by_pos",
     "mass_mean",
     "mass_p01",
     "mass_p50"
    ],
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "windows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
     },
     "positions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
     },
     "window_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
     },
     "ppl": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
     },
     "win_ppl": {
      "type": "array",
      "maxItems": 2048,
      "items": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 1000000
      }
     },
     "nll_by_pos": {
      "type": "array",
      "maxItems": 128,
      "items": {
       "type": "array",
       "minItems": 3,
       "maxItems": 3,
       "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000
       }
      }
     },
     "mass_mean": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.001
     },
     "mass_p01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.001
     },
     "mass_p50": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.001
     }
    }
   }
  },
  "eval_meta": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "model": {
     "type": "string",
     "maxLength": 200
    },
    "topk": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100000
    },
    "eval_set_sha256": {
     "type": "string",
     "maxLength": 64
    }
   }
  },
  "needle": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "items"
     ],
     "properties": {
      "model": {
       "type": "string",
       "maxLength": 200
      },
      "summary": {
       "type": "object",
       "maxProperties": 16,
       "propertyNames": {
        "pattern": "^[0-9]{1,9}$"
       },
       "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      },
      "items": {
       "type": "array",
       "maxItems": 400,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "length",
         "depth",
         "correct"
        ],
        "properties": {
         "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
         },
         "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         },
         "correct": {
          "type": "boolean"
         },
         "answer": {
          "type": "string",
          "maxLength": 64
         },
         "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
         }
        }
       }
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "gate_arm": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,32}$"
  },
  "thresholds": {
   "type": "array",
   "maxItems": 24,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "metric",
     "rule"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
     },
     "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "results": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
       "pattern": "^[A-Za-z0-9_.-]{1,32}$"
      },
      "additionalProperties": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "pass"
       ],
       "properties": {
        "value": {
         "type": "string",
         "maxLength": 40
        },
        "pass": {
         "type": "boolean"
        }
       }
      }
     }
    }
   }
  },
  "gates": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "task_delta_pts": {
     "type": "number",
     "minimum": -100,
     "maximum": 0
    },
    "top1_pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "ppl_delta_pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 10000
    },
    "kld_mean": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    }
   }
  },
  "hashes": {
   "type": "object",
   "maxProperties": 16,
   "propertyNames": {
    "maxLength": 64
   },
   "additionalProperties": {
    "anyOf": [
     {
      "type": "string",
      "maxLength": 128
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "think_dirs": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "string",
    "maxLength": 80
   }
  },
  "partials": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "string",
    "maxLength": 200
   }
  },
  "caveats": {
   "type": "array",
   "maxItems": 12,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 600
   }
  },
  "arms_note": {
   "type": "string",
   "maxLength": 600
  },
  "arms": {
   "type": "object",
   "maxProperties": 3,
   "propertyNames": {
    "pattern": "^[A-Za-z0-9_.-]{1,32}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "label"
    ],
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "description": {
      "type": "string",
      "maxLength": 300
     },
     "kld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "mean",
       "p50",
       "p99",
       "hist"
      ],
      "properties": {
       "mean": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "p50": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "p99": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "max": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000
       },
       "hist": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "edges",
         "counts"
        ],
        "properties": {
         "edges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 201,
          "items": {
           "type": "number",
           "minimum": 0,
           "maximum": 1000
          }
         },
         "counts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
           "type": "integer",
           "minimum": 0,
           "maximum": 1000000000
          }
         }
        }
       },
       "by_pos": {
        "type": "array",
        "maxItems": 128,
        "items": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
         }
        }
       }
      }
     },
     "top1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "agree"
      ],
      "properties": {
       "agree": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       },
       "n": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000000
       }
      }
     },
     "ppl": {
      "type": "object",
      "maxProperties": 3,
      "propertyNames": {
       "pattern": "^[A-Za-z0-9_.-]{1,32}$"
      },
      "additionalProperties": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "ref",
        "arm",
        "delta_pct"
       ],
       "properties": {
        "ref": {
         "type": "number",
         "exclusiveMinimum": 0,
         "maximum": 1000000
        },
        "arm": {
         "type": "number",
         "exclusiveMinimum": 0,
         "maximum": 1000000
        },
        "delta_pct": {
         "type": "number",
         "minimum": -100,
         "maximum": 10000
        }
       }
      }
     },
     "tasks": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
       "pattern": "^[A-Za-z0-9_.-]{1,32}$"
      },
      "additionalProperties": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "n",
        "delta",
        "ci",
        "ref_only",
        "test_only",
        "p"
       ],
       "properties": {
        "n": {
         "type": "integer",
         "minimum": 1,
         "maximum": 10000000
        },
        "delta": {
         "type": "number",
         "minimum": -100,
         "maximum": 100
        },
        "ci": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
         }
        },
        "ref_only": {
         "type": "integer",
         "minimum": 0,
         "maximum": 10000000
        },
        "test_only": {
         "type": "integer",
         "minimum": 0,
         "maximum": 10000000
        },
        "p": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       }
      }
     },
     "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "label",
       "kld_mean"
      ],
      "properties": {
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       },
       "kld_mean": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       }
      }
     },
     "spec_parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "vs",
       "identical",
       "n",
       "mismatches"
      ],
      "properties": {
       "vs": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,32}$"
       },
       "identical": {
        "type": "boolean"
       },
       "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
       },
       "mismatches": {
        "type": "array",
        "maxItems": 64,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "i",
          "token",
          "a",
          "b"
         ],
         "properties": {
          "i": {
           "type": "integer",
           "minimum": 0,
           "maximum": 100000
          },
          "token": {
           "type": "integer",
           "minimum": 0,
           "maximum": 10000000
          },
          "a": {
           "type": "string",
           "maxLength": 80
          },
          "b": {
           "type": "string",
           "maxLength": 80
          },
          "a_top2_gap": {
           "type": "number",
           "minimum": 0,
           "maximum": 1000
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}